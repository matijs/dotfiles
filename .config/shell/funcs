#!/usr/bin/env bash

dot() {
  local DOT_FILES="${HOME}/.dotfiles";

  # exit dotfiles-mode
  if [[ "${GIT_DIR}" == "${DOT_FILES}" ]]; then
    unset GIT_DIR
    return
  fi

  # enter dotfiles-mode
  if [[ "${PWD}" == "${HOME}" ]]; then
    export GIT_DIR=${DOT_FILES}
    return
  fi

  # trying to enter dotfiles-mode while not in ${HOME} errors
  printf '%s\n' "You need to be in ${HOME}" >&2
  return 1
}

r() {
  cd "$(git root)"
}

git() {
  # without arguments run git status
  if [[ $# -eq 0 ]]; then
    command git status
    return
  fi

  # prevent running git pull
  if [[ "$1" == "pull" ]]; then
    command printf '%s\n' "Use fetch instead" >&2
    return 1
  fi

  command git "$@"
}

f() {
  fzf --print0 | xargs -0 -o vim
}

tmux() {
  if [[ $# -eq 0 ]]; then
    command tmux new-session -A -s tmux -n  '~' -c "${HOME}"
  else
    command tmux "$@"
  fi
}
