# Straight from github.com/mathiasbynens/dotfiles

# Disguise as IE 9 on Windows 7.
user-agent = "Mozilla/5.0 (compatible; MSIE 9.0; Windows NT 6.1; Trident/5.0)"

# When following a redirect, automatically set the previous URL as referer.
referer = ";auto"

# Wait 60 seconds before timing out.
connect-timeout = 60

# Follow redirects (-L,--location).
location

# Write output to a local file named like the remote file we get (-O, --remote-name).
# (Only the file part of the remote file is used, the path is cut off.)
remote-name
